{
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/session-start-hook.mjs\"", "timeout": 10 }] },
      { "matcher": "compact|fork", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/sage-codex-hook.mjs\"", "timeout": 10, "additionalContextLimit": 6000 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/principles-hook.mjs\"", "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/sage-codex-hook.mjs\"", "timeout": 10, "additionalContextLimit": 6000 }] }
    ],
    "PreToolUse": [{ "matcher": "apply_patch|Bash", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/principles-hook.mjs\"", "timeout": 10 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/report-gate.mjs\"", "timeout": 10 }] }]
  }
}
