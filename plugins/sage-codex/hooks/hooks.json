{
  "hooks": {
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/principles-hook.mjs\"", "timeout": 10 }] }],
    "PreToolUse": [{ "matcher": "apply_patch|Bash", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/principles-hook.mjs\"", "timeout": 10 }] },
      { "matcher": "^(?:Bash|apply_patch)$", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/gate-hook.mjs\"", "timeout": 30 }] }],
    "PermissionRequest": [{ "matcher": "^Bash$", "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/hooks/gate-hook.mjs\"", "timeout": 30 }] }]
  }
}
