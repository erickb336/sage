{
  "Bash": { "extensions": ["bash", "bats", "cgi", "command", "env", "fcgi", "ksh", "sh", "tmux", "tool", "zsh"] },
  "C": { "extensions": ["c", "h"] },
  "Cpp": { "extensions": ["cc", "hpp", "cpp", "c++", "hh", "cxx", "cu", "ino"] },
  "CSharp": { "extensions": ["cs"] },
  "Css": { "extensions": ["css", "scss"] },
  "Dart": { "extensions": ["dart"] },
  "Elixir": { "extensions": ["ex", "exs"] },
  "Go": { "extensions": ["go"], "settings": ["revive: the exported rule"] },
  "Haskell": { "extensions": ["hs"] },
  "Hcl": { "extensions": ["hcl", "nomad", "tf", "tfvars", "workflow"] },
  "Html": { "extensions": ["html", "htm", "xhtml"], "rules": ["no-comments-html"] },
  "Java": { "extensions": ["java"] },
  "JavaScript": { "extensions": ["cjs", "js", "mjs", "jsx"], "rules": ["no-comments-js"], "settings": ["ESLint: jsdoc/require-jsdoc (eslint-plugin-jsdoc) and require-jsdoc"] },
  "Kotlin": { "extensions": ["kt", "ktm", "kts"] },
  "Lua": { "extensions": ["lua"] },
  "Nix": { "extensions": ["nix"] },
  "Php": { "extensions": ["php"] },
  "Python": { "extensions": ["py", "py3", "pyi", "bzl", "bazel"], "settings": ["Ruff: the D1 rules (D100 to D107)"] },
  "Ruby": { "extensions": ["rb", "rbw", "gemspec"] },
  "Rust": { "extensions": ["rs"], "settings": ["rustc: missing_docs", "Clippy: undocumented_unsafe_blocks"] },
  "Scala": { "extensions": ["scala", "sc", "sbt"] },
  "Solidity": { "extensions": ["sol"] },
  "Swift": { "extensions": ["swift"] },
  "TypeScript": { "extensions": ["ts", "cts", "mts"], "settings": ["ESLint: jsdoc/require-jsdoc (eslint-plugin-jsdoc)"] },
  "Tsx": { "extensions": ["tsx"], "settings": ["ESLint: jsdoc/require-jsdoc (eslint-plugin-jsdoc)"] },
  "Yaml": { "extensions": ["yaml", "yml"], "rules": ["no-comments-yaml"] },
  "Zig": { "extensions": ["zig"] }
}
